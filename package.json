{
  "name": "utsav-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Utsav: a GenAI planning assistant for weddings, birthdays and community events, with budgets, timelines, vendor checklists and personalised ideas.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "build": "vite build && node scripts/precompress.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/node/server/main.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:install": "playwright-core install chromium",
    "smoke:ai": "tsx scripts/smoke-ai.ts",
    "smoke:live": "node scripts/smoke-live.mjs",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run budget:bundle"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "compression": "1.8.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lru-cache": "11.5.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
