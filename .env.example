# Copy to .env for local development. Never commit real values; there are no secrets here.
PORT=8080
# vertex: Gemini on Vertex AI using Application Default Credentials (no API key).
# off: plans come from the built-in templates only.
AI_MODE=vertex
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
# Upper bound on Gemini calls per server instance per day.
DAILY_AI_CAP=500
